    <string name="info_description">This app reads live data from the ICE Portal API of the Deutsche Bahn ICE Wi-Fi and displays it clearly. Official Deutsche Bahn APIs are also used to provide station information.</string>
    <string name="info_privacy_title">Data protection</string>
    <string name="info_privacy_text">This app does not store or collect any personal data. Journey data is retrieved via the internal API within the train\'s Wi-Fi. Station data (facilities, elevator status) is loaded from the internet via official Deutsche Bahn APIs.</string>
    <string name="info_api_title">API</string>
    <string name="info_api_url1">https://iceportal.de/api1/rs/status</string>
    <string name="info_api_url2">https://iceportal.de/api1/rs/tripInfo/trip</string>
    <string name="info_api_url3">https://iceportal.de/api1/rs/pois/all</string>
    <string name="info_api_url4">https://iceportal.de/api1/rs/tripInfo/connection/{eva_nummer}</string>
